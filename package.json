{
  "name": "annotation-cast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "test:media": "node scripts/media-integration-test.mjs",
    "test:selection": "node tests/selection.browser.mjs",
    "test:markers": "node tests/markers.browser.mjs",
    "test:live": "node scripts/user-acceptance-test.mjs",
    "test:lifecycle": "node scripts/lifecycle-test.mjs",
    "test:soak-export": "node scripts/soak-export-test.mjs",
    "secrets": "node scripts/scan-secrets.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run secrets"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.18.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.38.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.4.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^5.0.5"
  }
}
